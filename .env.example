# ===== このファイルを「.env」という名前でコピーして、値を埋めてください =====

# Groq の APIキー（必須）。https://console.groq.com/keys で無料発行
GROQ_API_KEY=

# ログインのパスワード（必須）。複数人に配る場合は APP_PASSWORDS をカンマ区切りで
APP_PASSWORD=change-me
# APP_PASSWORDS=alice-pass,bob-pass,team-pass

# セッション署名鍵（公開運用では必ずランダムな長い文字列に）
SECRET_KEY=

# ----- ここから下は任意（既定値のままでOK）-----

# 文字起こしモデル: whisper-large-v3（日本語精度高） / whisper-large-v3-turbo（高速・低コスト）
GROQ_MODEL=whisper-large-v3

# 既定の言語: auto=自動判定 / ja=日本語 / en=英語
DEFAULT_LANGUAGE=auto

# アップロード上限(MB)
MAX_UPLOAD_MB=300

# 何秒ごとに分割するか（長い音声対策。既定600秒=10分）
CHUNK_SECONDS=600

# 本文中に時間(TC)を入れる目安の間隔（秒）。既定10秒
TC_INTERVAL_SECONDS=10

# ===== 大容量動画むけ：クラウドストレージ直アップロード（任意 / 未設定なら使われません）=====
# 大きい動画(2〜3GB)を扱いたい場合だけ設定。下の4つが全て埋まったときに有効になります。
# Cloudflare R2 の例（S3互換）。R2はegress無料。手順は README の「大容量動画」節を参照。
#   1) Cloudflare → R2 → バケット作成
#   2) R2 APIトークン(Object Read & Write)を発行して Access Key / Secret を取得
#   3) バケットのCORSで PUT,GET を許可し、ExposeHeaders に ETag を追加（必須）
# S3_ENDPOINT=https://<あなたのアカウントID>.r2.cloudflarestorage.com
# S3_BUCKET=transcriber-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# 直アップロードの上限(MB)。1本あたり。既定3000=約3GB
# STORAGE_MAX_UPLOAD_MB=3000
# これ以下のサイズは従来どおりサーバー経由で送る閾値(MB)。既定200
# DIRECT_UPLOAD_MAX_MB=200
# multipartの1パートの大きさ(MB)。既定64（最小5）
# UPLOAD_PART_MB=64
